<Project Sdk="Microsoft.NET.Sdk">
  <!-- Parity test of the plugin's hybrid mass port (Runtime/AetherStrandWebMass.cs) against the web deform, outside Unity.
       The runtime files it compiles use no UnityEngine types. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../unity-plugin/com.aetherstrand.sculptedhair/Runtime/AetherStrandWebMass.cs" />
    <Compile Include="../../../unity-plugin/com.aetherstrand.sculptedhair/Runtime/AetherStrandWebData.cs" />
    <Compile Include="../../../unity-plugin/com.aetherstrand.sculptedhair/Runtime/AetherStrandWebSolver.cs" />
  </ItemGroup>
</Project>
